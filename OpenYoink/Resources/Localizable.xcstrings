      }
    },
    "Open-Yoink is an independent clean-room implementation crafted for macOS. Bundled third-party components are Sparkle (MIT) for updates and mediaremote-adapter (BSD 3-Clause) for the optional local Now Playing module. A complete attribution record is available in THIRD_PARTY_NOTICES.md in the source repository." : {
      "extractionState" : "manual", "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open-Yoink is an independent clean-room implementation crafted for macOS. Bundled third-party components are Sparkle (MIT) for updates and mediaremote-adapter (BSD 3-Clause) for the optional local Now Playing module. A complete attribution record is available in THIRD_PARTY_NOTICES.md in the source repository." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Open-Yoink 是面向 macOS 的独立洁净室实现。内置第三方组件包括用于更新的 Sparkle（MIT），以及用于可选本地“正在播放”模块的 mediaremote-adapter（BSD 3-Clause）。完整署名记录见源码仓库中的 THIRD_PARTY_NOTICES.md。" } }
