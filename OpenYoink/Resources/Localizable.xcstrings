    "Shows artwork and controls from the active media player. Processing stays on this Mac; compatibility can vary after macOS updates." : {
      "extractionState" : "manual", "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows artwork and controls from the active media player. Processing stays on this Mac; compatibility can vary after macOS updates." } },
